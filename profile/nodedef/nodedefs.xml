<nodeDefs>

  <!-- Controller -->
  <nodeDef id="ecobee_controller" nodeType="139" nls="ecobee_controller">
    <sts>
      <st id="ST" editor="bool"/>
    </sts>
    <cmds>
      <sends/>
      <accepts>
        <cmd id="QUERY"/>
        <cmd id="DISCOVER"/>
      </accepts>
    </cmds>
  </nodeDef>

  <!-- Thermostat -->
  <nodeDef id="ecobee_thermostat" nodeType="139" nls="ecobee_thermostat">
    <sts>
      <st id="ST"    editor="temp_f"/>      <!-- Current temperature -->
      <st id="CLISPH" editor="temp_f"/>     <!-- Heat setpoint -->
      <st id="CLISPC" editor="temp_f"/>     <!-- Cool setpoint -->
      <st id="CLIMD" editor="mode"/>        <!-- HVAC mode -->
      <st id="CLIFS" editor="fan"/>         <!-- Fan mode -->
      <st id="CLIHUM" editor="humidity"/>   <!-- Current humidity % -->
      <st id="CLIHCS" editor="hcstate"/>    <!-- HVAC current state -->
      <st id="CLIFRS" editor="fanstate"/>   <!-- Fan running state -->
      <st id="CLISMD" editor="holdtype"/>   <!-- Active hold type -->
      <st id="GV0" editor="bool"/>          <!-- Connected -->
    </sts>
    <cmds>
      <sends/>
      <accepts>
        <cmd id="QUERY"/>
        <cmd id="SET_HEAT"    param="value" editor="temp_f"/>
        <cmd id="SET_COOL"    param="value" editor="temp_f"/>
        <cmd id="SET_MODE"    param="value" editor="mode"/>
        <cmd id="SET_FAN"     param="value" editor="fan"/>
        <cmd id="SET_CLIMATE" param="value" editor="climate"/>
        <cmd id="HOLD_AWAY"/>
        <cmd id="RESUME"/>
      </accepts>
    </cmds>
  </nodeDef>

  <!-- Current weather -->
  <nodeDef id="ecobee_weather" nodeType="139" nls="ecobee_weather">
    <sts>
      <st id="ST"  editor="temp_f"/>
      <st id="GV1" editor="humidity"/>
      <st id="GV2" editor="humidity"/>
      <st id="GV3" editor="temp_f"/>
      <st id="GV4" editor="temp_f"/>
      <st id="GV5" editor="wind_mph"/>
      <st id="GV6" editor="winddir"/>
      <st id="GV7" editor="sky"/>
      <st id="GV8" editor="wsymbol"/>
    </sts>
    <cmds>
      <sends/>
      <accepts>
        <cmd id="QUERY"/>
      </accepts>
    </cmds>
  </nodeDef>

  <!-- Tomorrow's forecast -->
  <nodeDef id="ecobee_forecast" nodeType="139" nls="ecobee_forecast">
    <sts>
      <st id="ST"  editor="temp_f"/>
      <st id="GV1" editor="humidity"/>
      <st id="GV2" editor="humidity"/>
      <st id="GV3" editor="temp_f"/>
      <st id="GV4" editor="temp_f"/>
      <st id="GV5" editor="wind_mph"/>
      <st id="GV6" editor="winddir"/>
      <st id="GV7" editor="sky"/>
      <st id="GV8" editor="wsymbol"/>
    </sts>
    <cmds>
      <sends/>
      <accepts>
        <cmd id="QUERY"/>
      </accepts>
    </cmds>
  </nodeDef>

  <!-- Remote sensor -->
  <nodeDef id="ecobee_sensor" nodeType="139" nls="ecobee_sensor">
    <sts>
      <st id="ST"    editor="temp_f"/>
      <st id="CLIHUM" editor="humidity"/>
      <st id="GV0" editor="occupancy"/>
    </sts>
    <cmds>
      <sends/>
      <accepts>
        <cmd id="QUERY"/>
      </accepts>
    </cmds>
  </nodeDef>

</nodeDefs>
